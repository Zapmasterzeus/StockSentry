<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>StockSentry - AI Financial Research</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
        }

        ::-webkit-scrollbar-thumb {
            background: #FFA500;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #FF8C00;
        }

        /* Loading overlay */
        #loadingOverlay {
            background: rgba(0, 0, 0, 0.85);
            position: fixed;
            inset: 0;
            display: none;
            z-index: 50;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            transition: opacity 0.3s ease;
        }

        #loadingOverlay.show {
            display: flex;
        }
    </style>
</head>

<body class="bg-gray-900 text-white font-sans antialiased min-h-screen flex items-center justify-center p-4">
    <div
        class="w-full max-w-lg bg-white bg-opacity-10 backdrop-blur-lg border border-white border-opacity-20 rounded-3xl p-8 shadow-2xl">

        <!-- Logo + Title -->
        <div class="text-center mb-6">
            <div
                class="w-24 h-24 mx-auto bg-gradient-to-r from-orange-500 via-orange-400 to-yellow-400 rounded-full flex items-center justify-center shadow-lg ring-4 ring-orange-300/40">
                <img src="/assets/logo.svg" alt="StockSentry Logo" class="w-12 h-12 invert drop-shadow-lg" />
            </div>

            <h1
                class="mt-4 text-4xl font-extrabold bg-gradient-to-r from-orange-400 to-yellow-400 bg-clip-text text-transparent">
                StockSentry
            </h1>
            <p class="text-gray-400">AI-Powered Financial Research & Analysis</p>
        </div>


        <!-- Error Message -->
        <!-- <% if (typeof error !=='undefined' ) { %>
            <div class="bg-red-600 text-white text-sm p-3 rounded-lg mb-6 flex items-center justify-center">
                <i class="fas fa-exclamation-triangle mr-2"></i>
                <%= error %>
            </div>
            <% } %> -->

                <!-- 🔍 Form -->
                <form action="/analyze" method="POST" id="analyzeForm" class="space-y-6 relative">
                    <div class="relative">
                        <label for="ticker" class="block text-sm font-semibold text-gray-300">Stock Ticker
                            Symbol</label>
                        <input type="text" id="ticker" name="ticker" placeholder="Enter ticker (e.g., TSLA, AAPL, MSFT)"
                            class="w-full p-3 mt-2 bg-transparent border border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                            autocomplete="off" required>
                        <div id="ticker-dropdown"
                            class="absolute left-0 right-0 mt-1 bg-gray-800 border border-gray-700 rounded-lg max-h-60 overflow-y-auto hidden z-10">
                        </div>
                    </div>

                    <button type="submit"
                        class="w-full py-3 bg-gradient-to-r from-orange-500 to-black text-white font-semibold rounded-lg shadow-md hover:from-orange-400 hover:to-gray-900 focus:outline-none focus:ring-2 focus:ring-orange-500 flex items-center justify-center">
                        <i class="fas fa-search mr-3"></i> Analyze Stock
                    </button>
                </form>

                <!-- Footer -->
                <div class="mt-8 text-center text-gray-400 text-sm">
                    <p>Powered by <span class="font-semibold text-orange-400">Sigan</span> | Flipr Hackathon 2025</p>
                </div>
    </div>

    <!-- 🔄 Loading Overlay -->
    <div id="loadingOverlay">
        <div class="animate-spin rounded-full h-20 w-20 border-t-4 border-b-4 border-orange-400 mb-6"></div>
        <p id="loadingText" class="text-2xl font-semibold tracking-wide text-orange-300">Analyzing Stock Data...</p>
        <p class="text-sm text-gray-400 mt-2">This may take a few seconds</p>
    </div>

    <!-- Script -->
    <script>
        const form = document.getElementById("analyzeForm");
        const loader = document.getElementById("loadingOverlay");
        const loadingText = document.getElementById("loadingText");

        form.addEventListener("submit", () => {
            const ticker = document.getElementById("ticker").value.trim().toUpperCase();
            if (!ticker) {
                alert("Please enter a valid stock ticker.");
                return;
            }
            loadingText.textContent = `Analyzing ${ticker}...`;
            loader.classList.add("show");
        });

        // --- Autocomplete Dropdown ---
        const popularTickers = [
            { symbol: 'AAPL', name: 'Apple Inc.' },
            { symbol: 'MSFT', name: 'Microsoft Corporation' },
            { symbol: 'GOOGL', name: 'Alphabet Inc. Class A' },
            { symbol: 'AMZN', name: 'Amazon.com Inc.' },
            { symbol: 'TSLA', name: 'Tesla Inc.' },
            { symbol: 'META', name: 'Meta Platforms Inc.' },
            { symbol: 'NVDA', name: 'NVIDIA Corporation' },
            { symbol: 'NFLX', name: 'Netflix Inc.' },
            { symbol: 'AMD', name: 'Advanced Micro Devices' },
            { symbol: 'INTC', name: 'Intel Corporation' },
            { symbol: 'ORCL', name: 'Oracle Corporation' },
            { symbol: 'CRM', name: 'Salesforce, Inc.' },
            { symbol: 'ADBE', name: 'Adobe Inc.' },
            { symbol: 'CSCO', name: 'Cisco Systems, Inc.' },
            { symbol: 'PYPL', name: 'PayPal Holdings, Inc.' },
            { symbol: 'SQ', name: 'Block, Inc.' },
            { symbol: 'UBER', name: 'Uber Technologies, Inc.' },
            { symbol: 'ZM', name: 'Zoom Video Communications' },
            { symbol: 'DIS', name: 'The Walt Disney Company' },
            { symbol: 'WMT', name: 'Walmart Inc.' },
            { symbol: 'V', name: 'Visa Inc.' },
            { symbol: 'MA', name: 'Mastercard Incorporated' },
            { symbol: 'JPM', name: 'JPMorgan Chase & Co.' },
            { symbol: 'BAC', name: 'Bank of America Corporation' },
            { symbol: 'XOM', name: 'Exxon Mobil Corporation' },
            { symbol: 'KO', name: 'The Coca-Cola Company' },
            { symbol: 'PG', name: 'Procter & Gamble Co.' },
            { symbol: 'NKE', name: 'Nike Inc.' },
            { symbol: 'PEP', name: 'PepsiCo Inc.' },
            { symbol: 'BABA', name: 'Alibaba Group Holding Ltd.' },
            { symbol: 'INTU', name: 'Intuit Inc.' },
            { symbol: 'SPOT', name: 'Spotify Technology S.A.' },
            { symbol: 'SNAP', name: 'Snap Inc.' },
            { symbol: 'LYFT', name: 'Lyft Inc.' },
            { symbol: 'TWLO', name: 'Twilio Inc.' },
            { symbol: 'GE', name: 'General Electric Company' },
            { symbol: 'BA', name: 'The Boeing Company' },
            { symbol: 'CAT', name: 'Caterpillar Inc.' },
            { symbol: 'CVX', name: 'Chevron Corporation' },
            { symbol: 'T', name: 'AT&T Inc.' },
            { symbol: 'VZ', name: 'Verizon Communications' },
            { symbol: 'UPS', name: 'United Parcel Service' },
            { symbol: 'FDX', name: 'FedEx Corporation' },
            { symbol: 'GS', name: 'Goldman Sachs Group, Inc.' },
            { symbol: 'C', name: 'Citigroup Inc.' },
            { symbol: 'IBM', name: 'International Business Machines' },
            { symbol: 'MMM', name: '3M Company' },
            { symbol: 'AIG', name: 'American International Group' },
            { symbol: 'BRK.B', name: 'Berkshire Hathaway Inc.' }
        ];

        const tickerInput = document.getElementById('ticker');
        const dropdown = document.getElementById('ticker-dropdown');
        let searchTimeout = null;

        function debounce(func, wait) {
            return (...args) => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => func(...args), wait);
            };
        }

        function showDropdown(matches) {
            if (matches.length === 0) {
                dropdown.classList.add('hidden');
                return;
            }

            dropdown.innerHTML = matches.map(t => `
        <div class="px-4 py-2 cursor-pointer hover:bg-gray-700" data-symbol="${t.symbol}">
          <div class="font-semibold text-orange-400">${t.symbol}</div>
          <div class="text-sm text-gray-400">${t.name}</div>
        </div>`).join('');
            dropdown.classList.remove('hidden');
        }

        const debouncedSearch = debounce(query => {
            if (!query) {
                dropdown.classList.add('hidden');
                return;
            }
            const matches = popularTickers.filter(t =>
                t.symbol.startsWith(query.toUpperCase()) ||
                t.name.toUpperCase().includes(query.toUpperCase())
            ).slice(0, 8);
            showDropdown(matches);
        }, 250);

        tickerInput.addEventListener('input', e => debouncedSearch(e.target.value));
        dropdown.addEventListener('click', e => {
            const item = e.target.closest('[data-symbol]');
            if (item) {
                tickerInput.value = item.dataset.symbol;
                dropdown.classList.add('hidden');
            }
        });

        document.addEventListener('click', e => {
            if (!tickerInput.contains(e.target) && !dropdown.contains(e.target))
                dropdown.classList.add('hidden');
        });
    </script>
</body>

</html>